#!/bin/bash
# Used by yay instead of sudo (yay --sudo <this file>), so AUR installs can ask
# for the password through a normal graphical polkit prompt. Only pacman calls
# are forwarded, to the ArchUpdater root helper.
set -u
here="$(dirname "$(readlink -f "$0")")"

# Drop sudo-style options (e.g. -v) that yay may pass before the command.
while [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; do
  shift
done
[ $# -eq 0 ] && exit 0

case "$(basename "$1")" in
  pacman)
    shift
    exec pkexec "$here/archupdater-root" pacman "$@"
    ;;
  *)
    echo "archupdater-sudo: refusing to run '$1' as root" >&2
    exit 1
    ;;
esac
